-- [GÖRÜNÜM]
local AvSec = Visuals:NewSection("Özel Parçalar")
AvSec:NewButton("Headless (Kafasızlık)", "Görsel", function()
    game.Players.LocalPlayer.Character.Head.Transparency = 1
    if game.Players.LocalPlayer.Character.Head:FindFirstChild("face") then
        game.Players.LocalPlayer.Character.Head.face:Destroy()
    end
end)
AvSec:NewButton("Korblox (Sağ Bacak)", "Görsel", function()
    local c = game.Players.LocalPlayer.Character
    if c:FindFirstChild("RightUpperLeg") then
        c.RightUpperLeg:Destroy()
        c.RightLowerLeg:Destroy()
        c.RightFoot:Destroy()
    end
end)
Visuals:NewSection("Avatar Kopyalayıcı"):NewTextBox("İsim Yaz", "Kopyala", function(t)
    local target = game.Players:FindFirstChild(t)
    if target then
        local myChar = game.Players.LocalPlayer.Character
        for _, v in pairs(myChar:GetChildren()) do if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") then v:Destroy() end end
        for _, v in pairs(target.Character:GetChildren()) do if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") then v:Clone().Parent = myChar end end
    end
end)

-- [TROLL]
local TrlSec = Troll:NewSection("Fırlatma Sistemleri")
TrlSec:NewToggle("Süper Fling", "Değdiğini uçurur", function(state)
    _G.fling = state
    while _G.fling do
        local hrp = game.Players.LocalPlayer.Character.HumanoidRootPart
        hrp.Velocity = Vector3.new(0, 10000, 0)
        hrp.RotVelocity = Vector3.new(0, 10000, 0)
        task.wait(0.1)
    end
end)
TrlSec:NewToggle("Anti-Fling", "Sarsılmazlık", function(state)
    _G.af = state
    game:GetService("RunService").Stepped:Connect(function()
        if _G.af then
            for _, v in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
end)

