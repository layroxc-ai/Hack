-- [[ Slider Kontrolü (Dokunmatik) ]] --
local function UpdateSpeedLabel()
    SpeedSlider.Text = "Hız Çarpanı: " .. string.format("%.1f", SpeedMultiplier) .. "x"
end

SpeedSlider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        local dragStart = input.Position.X
        SpeedSlider.MouseButton1Down:Connect(function()
            local con
            con = RunService.RenderStepped:Connect(function()
                local pos = UserInputService:GetMouseLocation().X
                local multiplier = math.clamp((pos - dragStart) / 200, 0.5, 3.0)
                SpeedMultiplier = math.round(multiplier * 10) / 10
                UpdateSpeedLabel()
            end)
            UserInputService.InputEnded:Connect(function(endInput)
                if endInput.UserInputType == Enum.UserInputType.Touch then
                    con:Disconnect()
                end
            end)
        end)
    end
end)

