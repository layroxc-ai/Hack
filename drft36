-- [[ Auto Farm Fonksiyonu ]] --
local function FindFarmPart()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("track") or v.Name:lower():find("road") then
            if v.Size.X > 50 and v.Size.Z > 50 then
                return v
            end
        end
    end
    return nil
end

local function StartAutoFarm()
    FarmPart = FindFarmPart()
    if not FarmPart then return end
    local vehicle = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("VehicleSeat")
    if not vehicle then return end
    local hrp = vehicle:FindFirstChild("HumanoidRootPart") or vehicle.PrimaryPart
    if not hrp then return end
    local targetPos = FarmPart.Position + Vector3.new(0, 5, 0)
    local tween = TweenService:Create(hrp, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    tween:Play()
end

-- [[ Speed Hack ]] --
local function ApplySpeed()
    local vehicle = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("VehicleSeat")
    if not vehicle then return end
    local engine = vehicle:FindFirstChild("Engine") or vehicle:FindFirstChild("Throttle")
    if engine then
        engine.Throttle = SpeedMultiplier * 2
    end
    -- Alternatif: Hızlandırma
    local hrp = vehicle:FindFirstChild("HumanoidRootPart") or vehicle.PrimaryPart
    if hrp and SpeedHack then
        hrp.Velocity = hrp.CFrame.LookVector * (hrp.Velocity.Magnitude * SpeedMultiplier)
    end
end

