-- [[ Anti-Ban Koruması ]] --
local function AntiBan()
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local args = {...}
        if string.lower(tostring(args[1])):find("detect") or string.lower(tostring(args[1])):find("ban") then
            return
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end
AntiBan()

