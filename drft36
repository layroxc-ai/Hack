-- Mobil Sürükleme Desteği
local dragging = false
local dragStart, dragStartPos

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        dragStartPos = mainFrame.Position
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        local newX = dragStartPos.X.Scale + (delta.X / screenGui.AbsoluteSize.X)
        local newY = dragStartPos.Y.Scale + (delta.Y / screenGui.AbsoluteSize.Y)
        mainFrame.Position = UDim2.new(newX, 0, newY, 0)
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- Araç Bulma ve Hızlandırma
local function getVehicle()
    if character and character:FindFirstChild("Humanoid") and character.Humanoid.SeatPart then
        local seat = character.Humanoid.SeatPart
        local parent = seat.Parent
        if parent and parent:IsA("VehicleSeat") and parent.Parent then
            return parent.Parent
        end
    end
    return nil
end

-- Hızlandırma Döngüsü
RunService.Heartbeat:Connect(function(delta)
    vehicle = getVehicle()
    if vehicle and vehicle:IsA("Model") then
        local root = vehicle:FindFirstChild("PrimaryPart") or vehicle:FindFirstChildWhichIsA("BasePart")
        if root then
            local velocity = root.Velocity
            local currentSpeed = velocity.Magnitude * 3.6 -- m/s -> km/h
            speedDisplay.Text = string.format("%.1f km/h", currentSpeed)
            
            local fillPercent = math.clamp(currentSpeed / maxSpeed, 0, 1)
            speedFill.Size = UDim2.new(fillPercent, 0, 1, 0)
            
            -- Hız rengi dinamik
            local r = math.clamp(fillPercent * 2, 0, 1)
            local g = math.clamp(1 - fillPercent * 0.5, 0.3, 1)
            speedFill.BackgroundColor3 = Color3.fromRGB(r * 255, g * 255, 50)
            
            -- Hızlandırma uygula (orijinal fonksiyonun gelişmiş hali)
            if speedMultiplier > 1 then
                local forward = root.CFrame.LookVector
                local extraForce = forward * (speedMultiplier - 1) * 200
                root:ApplyImpulse(extraForce * delta * 10)
            end
        end
    else
        speedDisplay.Text = "🚫 Araç yok"
        speedFill.Size = UDim2.new(0, 0, 1, 0)
    end
end)

