-- Menüyü sürüklemek için (dokunmatik)
local dragToggle = false
local dragStart, dragStartPos

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        dragToggle = true
        dragStart = input.Position
        dragStartPos = mainFrame.Position
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if dragToggle and input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        local scaleX = dragStartPos.X.Scale + (delta.X / screenGui.AbsoluteSize.X)
        local scaleY = dragStartPos.Y.Scale + (delta.Y / screenGui.AbsoluteSize.Y)
        mainFrame.Position = UDim2.new(scaleX, 0, scaleY, 0)
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        dragToggle = false
    end
end)

-- Araç hızlandırma fonksiyonu
local function getVehicle()
    if character and character:FindFirstChild("Humanoid") and character.Humanoid.SeatPart then
        local seat = character.Humanoid.SeatPart
        local parent = seat.Parent
        if parent and parent:IsA("VehicleSeat") and parent.Parent then
            return parent.Parent
        end
    end
    return nil
end

-- Hız döngüsü
RunService.Heartbeat:Connect(function(delta)
    vehicle = getVehicle()
    if vehicle and vehicle:IsA("Model") then
        local root = vehicle:FindFirstChild("PrimaryPart") or vehicle:FindFirstChildWhichIsA("BasePart")
        if root then
            local velocity = root.Velocity
            local speed = velocity.Magnitude * 3.6
            speedDisplay.Text = string.format("%.1f km/h", speed)
            local pct = math.clamp(speed / 350, 0, 1)
            fill.Size = UDim2.new(pct, 0, 1, 0)
            fill.BackgroundColor3 = Color3.fromRGB(math.clamp(pct*2,0,1)*255, (1-math.clamp(pct*0.5,0,1))*255, 50)
            
            if speedMultiplier > 1 then
                local f = root.CFrame.LookVector
                root:ApplyImpulse(f * (speedMultiplier - 1) * 250 * delta)
            end
        end
    else
        speedDisplay.Text = "🚫 Araç yok"
        fill.Size = UDim2.new(0, 0, 1, 0)
    end
end)

