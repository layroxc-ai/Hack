        ShowHealth = true,
        ShowDistance = true,
        BoxColor = Color3.fromRGB(255, 0, 0),
        NameColor = Color3.fromRGB(255, 255, 255),
        HealthColor = Color3.fromRGB(0, 255, 0),
        DistanceColor = Color3.fromRGB(200, 200, 200)
    },
    Wallhack = {
        Enabled = true,
        Transparency = 0.3      -- 0 = tam görünmez, 1 = tam opak
    },
    AutoShoot = {
