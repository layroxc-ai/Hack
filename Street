    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextScaled = true
    label.Font = Enum.Font.Gotham
    label.Parent = frame
    
    if desc then
        local descLabel = Instance.new("TextLabel")
        descLabel.Size = UDim2.new(0.65, 0, 0.4, 0)
        descLabel.Position = UDim2.new(0, 0, 0.6, 0)
        descLabel.BackgroundTransparency = 1
        descLabel.Text = desc
        descLabel.TextColor3 = Color3.fromRGB(150,150,150)
        descLabel.TextXAlignment = Enum.TextXAlignment.Left
        descLabel.TextScaled = true
        descLabel.Font = Enum.Font.Gotham
        descLabel.Parent = frame
    end
    
    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0.25, 0, 0.8, 0)
    toggle.Position = UDim2.new(0.75, 0, 0.1, 0)
    toggle.BackgroundColor3 = getter() and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(60, 60, 80)
    toggle.Text = getter() and "✅ AÇIK" or "❌ KAPALI"
    toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggle.TextScaled = true
    toggle.Font = Enum.Font.Gotham
    toggle.Parent = frame
    
    -- Mobil için dokunmatik destek
    toggle.MouseButton1Click:Connect(function()
        local newVal = not getter()
        setter(newVal)
        toggle.Text = newVal and "✅ AÇIK" or "❌ KAPALI"
        toggle.BackgroundColor3 = newVal and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(60, 60, 80)
        -- Farm aktifliğini güncelle
        if labelText:find("Oil") or labelText:find("Petrol") then
            farmManager.oil.active = newVal
        elseif labelText:find("Mob") then
            farmManager.mob.active = newVal
        elseif labelText:find("Ice") or labelText:find("Dondurma") then
            farmManager.ice.active = newVal
        elseif labelText:find("Unlock") or labelText:find("Aç") then
            farmManager.unlock.active = newVal
        end
    end)
    return toggle
end

function createSlider(labelText, min, max, getter, setter, suffix, desc)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 55)
    frame.BackgroundTransparency = 1
    frame.Parent = scroll
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 0.4, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextScaled = true
    label.Font = Enum.Font.Gotham
    label.Parent = frame
    
    if desc then
        local descLabel = Instance.new("TextLabel")
        descLabel.Size = UDim2.new(0.7, 0, 0.3, 0)
        descLabel.Position = UDim2.new(0, 0, 0.4, 0)
        descLabel.BackgroundTransparency = 1
        descLabel.Text = desc
        descLabel.TextColor3 = Color3.fromRGB(150,150,150)
        descLabel.TextXAlignment = Enum.TextXAlignment.Left
        descLabel.TextScaled = true
        descLabel.Font = Enum.Font.Gotham
        descLabel.Parent = frame
    end
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.3, 0, 0.4, 0)
    valueLabel.Position = UDim2.new(0.7, 0, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(getter()) .. (suffix or "")
    valueLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
    valueLabel.TextScaled = true
    valueLabel.Font = Enum.Font.Gotham
    valueLabel.Parent = frame
    
    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(1, 0, 0.3, 0)
    slider.Position = UDim2.new(0, 0, 0.6, 0)
    slider.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    slider.BorderSizePixel = 0
    slider.Parent = frame
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((getter() - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    fill.BorderSizePixel = 0
    fill.Parent = slider
    
    local function updateSlider(newVal)
        local clamped = math.clamp(newVal, min, max)
        setter(clamped)
        fill.Size = UDim2.new((clamped - min) / (max - min), 0, 1, 0)
        valueLabel.Text = tostring(math.round(clamped)) .. (suffix or "")
    end
    
    -- Fare ve dokunmatik için
    local function onInputBegin(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local function move(input2)
                local pos
                if input2.UserInputType == Enum.UserInputType.Touch then
                    pos = (input2.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X
                else
                    pos = (mouse.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X
                end
                local val = min + pos * (max - min)
                updateSlider(val)
            end
            move(input)
            local conn
            if input.UserInputType == Enum.UserInputType.Touch then
                conn = userInputService.TouchMoved:Connect(move)
            else
                conn = mouse.Move:Connect(function() move(input) end)
            end
            local release = userInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == input.UserInputType then
                    conn:Disconnect()
                    release:Disconnect()
                end
            end)
        end
    end
    slider.InputBegan:Connect(onInputBegin)
end

