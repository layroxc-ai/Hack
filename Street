-- GÜVENLİ HAREKET (Tween)
local function safeMove(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local distance = (hrp.Position - targetCFrame.Position).Magnitude
        local speed = 20 -- Kick yememek için güvenli hız
        local duration = distance / speed
        local ts = game:GetService("TweenService")
        local tween = ts:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        tween:Play()
        return tween
    end
end

-- BUTON OLUŞTURUCU
local function createBtn(text, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 200, 0, 50)
    btn.Position = UDim2.new(0, 10, 0, pos)
    btn.Text = text .. ": KAPALI"
    btn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Parent = Main
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. (state and ": AÇIK" or ": KAPALI")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(150, 0, 0)
        callback(state)
    end)
end

-- 1. PASPAS FARM (MOP FARM)
local mopActive = false
createBtn("Otomatik Paspas Farm", 60, function(val)
    mopActive = val
    spawn(function()
        while mopActive do
            -- Haritadaki kirleri/lekeleri ara
            for _, v in pairs(game.Workspace:GetDescendants()) do
                if mopActive and (v.Name:find("Dirt") or v.Name:find("Stain") or v.Name:find("Paspas")) then
                    local t = safeMove(v.CFrame * CFrame.new(0, 2, 0))
                    if t then t.Completed:Wait() end
                    task.wait(1) -- Temizleme süresi
                end
            end
            task.wait(2)
        end
    end)
end)

-- 2. ULTRA HITBOX (20M)
local hbActive = false
createBtn("Ultra Hitbox (20m)", 120, function(val)
    hbActive = val
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if hbActive then
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= game.Players.LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                -- 20 Metre devasa hitbox
                hrp.Size = Vector3.new(20, 20, 20)
                hrp.Transparency = 0.7
                hrp.BrickColor = BrickColor.new("Bright red")
                hrp.CanCollide = false
            end
        end
    end
end)

-- 3. GÜVENLİ SAKLANMA (GÖKYÜZÜ)
createBtn("Saklan (Havada Dur)", 180, function(val)
    local hrp = game.Players.LocalPlayer.Character.HumanoidRootPart
    if val then
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 300, 0)
        local bv = Instance.new("BodyVelocity") -- Havada asılı kalmak için
        bv.Name = "StayFly"
        bv.Velocity = Vector3.new(0,0,0)
        bv.Parent = hrp
    else
        if hrp:FindFirstChild("StayFly") then hrp.StayFly:Destroy() end
        hrp.CFrame = hrp.CFrame * CFrame.new(0, -300, 0)
    end
end)

