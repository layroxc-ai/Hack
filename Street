-- ESP SİSTEMİ (Drawing)
-- ============================================================
local espObjects = {}

function refreshESP()
    for _, obj in pairs(espObjects) do
        obj:Destroy()
    end
    espObjects = {}
    if not settings.espEnabled then return end

    for _, plr in pairs(players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                if settings.espBox then
                    local box = Instance.new("BoxHandleAdornment")
                    box.Size = Vector3.new(3, 5, 1.5)
                    box.Adornee = root
                    box.Color3 = settings.espColor
                    box.Transparency = 0.4
                    box.ZIndex = 0
                    box.Parent = plr.Character
                    table.insert(espObjects, box)
                end
                if settings.espTracer then
                    local line = Instance.new("LineHandleAdornment")
                    line.Thickness = 2
                    line.Color3 = settings.espColor
                    line.Adornee = root
                    line.Parent = plr.Character
                    table.insert(espObjects, line)
                end
                if settings.espName or settings.espDistance then
                    local bill = Instance.new("BillboardGui")
                    bill.Size = UDim2.new(0, 180, 0, 30)
                    bill.Adornee = root
                    bill.StudsOffset = Vector3.new(0, 3.5, 0)
                    bill.Parent = plr.Character
                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(1,0,1,0)
                    label.BackgroundTransparency = 1
                    label.TextColor3 = settings.espColor
                    label.TextScaled = true
                    label.Font = Enum.Font.GothamBold
                    label.Parent = bill
                    local function updateText()
                        local name = settings.espName and plr.Name or ""
                        local dist = settings.espDistance and (" " .. math.round((root.Position - (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position or Vector3.zero)).Magnitude) .. "m") or ""
                        label.Text = name .. dist
                    end
                    updateText()
                    local conn = runService.RenderStepped:Connect(function()
                        if not bill.Parent then conn:Disconnect() return end
                        updateText()
                    end)
                    table.insert(espObjects, bill)
                    table.insert(espObjects, conn)
                end
            end
        end
    end
end

