-- ===== FARM FONKSİYONLARI (GERÇEK OYUN İÇİN ÖRNEK) =====
-- NOT: Street Life oyunundaki spesifik objeleri/etkileşimleri bilmediğim için
-- burada genel bir yapı kuruyorum. Gerçek farm işlemleri için oyundaki
-- RemoteEvent veya touch/click mekaniklerine göre düzenlemen gerekebilir.
-- Ama ben sana örnek mantığı veriyorum.

local function findNearestObject(className, distance)
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local nearest = nil
    local minDist = distance or settings.farmRadius
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA(className) and obj:FindFirstChild("TouchInterest") then -- örnek
            local dist = (obj.Position - root.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = obj
            end
        end
    end
    return nearest
end

-- Oil Farm (Petrol)
local function oilFarm()
    if not settings.oilFarmEnabled then return end
    local oilObj = findNearestObject("Part", 50) -- örnek, gerçekte "Oil" tag veya model
    if oilObj then
        -- Örnek: fire touch event veya click detector
        local click = oilObj:FindFirstChild("ClickDetector")
        if click then
            click:FireClick() -- veya fire event
        else
            -- belki remote event
            local remote = replicatedStorage:FindFirstChild("OilCollect")
            if remote then remote:FireServer(oilObj) end
        end
        farmManager.oil.status = "Çalışıyor (Petrol toplanıyor)"
    else
        farmManager.oil.status = "Petrol bulunamadı, bekleniyor..."
    end
end

-- Mob Farm (Canavar)
local function mobFarm()
    if not settings.mobFarmEnabled then return end
    local mob = findNearestObject("Model", 50) -- moblar genelde model
    if mob and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
        -- Saldırma işlemi (örnek: equip weapon, attack remote)
        local attackRemote = replicatedStorage:FindFirstChild("AttackMob")
        if attackRemote then
            attackRemote:FireServer(mob)
        end
        farmManager.mob.status = "Çalışıyor (Mob dövülüyor)"
    else
        farmManager.mob.status = "Mob yok veya ölü, bekleniyor..."
    end
end

-- Ice Farm (Dondurma)
local function iceFarm()
    if not settings.iceFarmEnabled then return end
    local iceObj = findNearestObject("Part", 50) -- dondurma tezgahı vb.
    if iceObj then
        local click = iceObj:FindFirstChild("ClickDetector")
        if click then
            click:FireClick()
        end
        farmManager.ice.status = "Çalışıyor (Dondurma toplanıyor)"
    else
        farmManager.ice.status = "Dondurma bulunamadı"
    end
end

-- Auto Unlock: Tüm pazarları, alanları satın al / aç
local function autoUnlock()
    if not settings.autoUnlockEnabled then return end
    -- Örnek: Tüm "Buy" butonlarını tıkla, veya remote event gönder
    local buyButtons = workspace:FindFirstChild("BuyButtons") -- örnek
    if buyButtons then
        for _, btn in pairs(buyButtons:GetChildren()) do
            if btn:IsA("ClickDetector") then
                btn:FireClick()
            end
        end
    end
    -- Alternatif: Remote event
    local unlockRemote = replicatedStorage:FindFirstChild("UnlockAll")
    if unlockRemote then
        unlockRemote:FireServer()
    end
    farmManager.unlock.status = "Açma işlemi çalışıyor..."
end

-- ===== OTOMATİK YENİDEN BAŞLATMA KONTROLÜ =====
local function checkAndRestartFarm()
    if not settings.autoRestartEnabled then return end
    
    -- Oil kontrol
    if settings.oilFarmEnabled and not farmManager.oil.active then
        farmManager.oil.active = true
        farmManager.oil.status = "Yeniden başlatıldı (Oil)"
    end
    -- Mob kontrol
    if settings.mobFarmEnabled and not farmManager.mob.active then
        farmManager.mob.active = true
        farmManager.mob.status = "Yeniden başlatıldı (Mob)"
    end
    -- Ice kontrol
    if settings.iceFarmEnabled and not farmManager.ice.active then
        farmManager.ice.active = true
        farmManager.ice.status = "Yeniden başlatıldı (Ice)"
    end
    -- Unlock kontrol
    if settings.autoUnlockEnabled and not farmManager.unlock.active then
        farmManager.unlock.active = true
        farmManager.unlock.status = "Yeniden başlatıldı (Unlock)"
    end
end

-- ===== FARM DÖNGÜSÜ =====
runService.RenderStepped:Connect(function(deltaTime)
    -- Farm işlemlerini çalıştır
    if settings.oilFarmEnabled then
        oilFarm()
    else
        farmManager.oil.active = false
        farmManager.oil.status = "Durduruldu"
    end
    
    if settings.mobFarmEnabled then
        mobFarm()
    else
        farmManager.mob.active = false
        farmManager.mob.status = "Durduruldu"
    end
    
    if settings.iceFarmEnabled then
        iceFarm()
    else
        farmManager.ice.active = false
        farmManager.ice.status = "Durduruldu"
    end
    
    if settings.autoUnlockEnabled then
        autoUnlock()
    else
        farmManager.unlock.active = false
        farmManager.unlock.status = "Durduruldu"
    end
    
    -- Otomatik yeniden başlatma kontrolü (her 5 saniyede bir)
    if tick() - (farmManager.lastCheck or 0) > 5 then
        checkAndRestartFarm()
        farmManager.lastCheck = tick()
    end
end)

