-- EKRAN BUTONLARI OLUŞTURMA (Menü açılmama sorununa kesin çözüm)
local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
ScreenGui.Name = "LayroxcSimpleMenu"

local function CreateButton(name, pos, color, callback)
    local btn = Instance.new("TextButton", ScreenGui)
    btn.Name = name
    btn.Size = UDim2.new(0, 150, 0, 40)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.Text = name .. ": KAPALI"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 18
    
    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.Text = name .. (active and ": AÇIK" or ": KAPALI")
        btn.BackgroundColor3 = active and Color3.new(0, 0.7, 0) or color
        callback(active)
    end)
end

-- AYARLAR
local Ayarlar = {
    HitboxAcik = false,
    TekAtmaAcik = false,
    Boyut = 20
}

-- BUTONLARI YERLEŞTİR
CreateButton("HITBOX", UDim2.new(0, 10, 0, 50), Color3.new(0.2, 0.2, 0.2), function(s) Ayarlar.HitboxAcik = s end)
CreateButton("TEK ATMA", UDim2.new(0, 10, 0, 100), Color3.new(0.2, 0.2, 0.2), function(s) Ayarlar.TekAtmaAcik = s end)

-- ANTI-KICK (Atılmayı Engelleme)
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if method == "Kick" or method == "kick" then return nil end
    return old(self, ...)
end)

-- ANA DÖNGÜ (Hitbox ve Tek Atma)
task.spawn(function()
    while task.wait(0.5) do
        for _, pl in pairs(game:GetService("Players"):GetPlayers()) do
            if pl ~= game.Players.LocalPlayer and pl.Character then
                local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character:FindFirstChild("Humanoid")

                -- Hitbox Uygula
                if hrp and Ayarlar.HitboxAcik then
                    hrp.Size = Vector3.new(Ayarlar.Boyut, Ayarlar.Boyut, Ayarlar.Boyut)
                    hrp.Transparency = 0.7
                    hrp.CanCollide = false
                elseif hrp then
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                end

                -- Tek Atma Uygula (Hasar Aldığı An Öldürür)
                if hum and Ayarlar.TekAtmaAcik then
                    if hum.Health < hum.MaxHealth and hum.Health > 0 then
                        hum.Health = 0
                    end
                end
            end
        end
    end
end)

print("Layroxc Butonlu Menü Yüklendi!")
