-- ========== YARDIMCI FONKSÄ°YONLAR ==========
local function GetPlayers()
    local list = {}
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            table.insert(list, v)
        end
    end
    return list
end

local function WorldToScreen(pos)
    local vec, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(vec.X, vec.Y), onScreen, vec.Z
end

local function GetClosestPlayer(fov)
    local closest = nil
    local closestDist = fov or math.huge
    for _, player in pairs(GetPlayers()) do
        local torso = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Torso")
        if torso then
            local screenPos, onScreen = WorldToScreen(torso.Position)
            if onScreen then
                local dist = (Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2) - screenPos).Magnitude
                if dist < closestDist then
                    closest = player
                    closestDist = dist
                end
            end
        end
    end
    return closest
end

-- ========== ESP ==========
local espObjects = {}
local function CreateESP(player)
    if espObjects[player] then return end
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Settings.ESPColor
    box.Thickness = Settings.BoxThickness
    box.Filled = false

    local nameTag = Drawing.new("Text")
    nameTag.Visible = false
    nameTag.Color = Color3.new(1, 1, 1)
    nameTag.Size = 14
    nameTag.Center = true

    local distTag = Drawing.new("Text")
    distTag.Visible = false
    distTag.Color = Color3.new(0.8, 0.8, 0.8)
    distTag.Size = 12
    distTag.Center = true

    local healthBar = Drawing.new("Line")
    healthBar.Visible = false
    healthBar.Color = Color3.new(0, 1, 0)
    healthBar.Thickness = Settings.HealthBarWidth

    espObjects[player] = {box = box, nameTag = nameTag, distTag = distTag, healthBar = healthBar}
end

local function UpdateESP()
    for player, obj in pairs(espObjects) do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char.Humanoid.Health > 0 then
            local root = char.HumanoidRootPart
            local pos = root.Position
            local size = char:GetExtentsSize()
            local screenPos, onScreen, depth = WorldToScreen(pos)
            local headPos = char:FindFirstChild("Head") and char.Head.Position or pos + Vector3.new(0, size.Y/2, 0)
            local headScreen, _ = WorldToScreen(headPos)

            if onScreen then
                local height = size.Y * 1.5
                local width = size.X * 1.2
                local topLeft = screenPos - Vector2.new(width/2, height/2)
                local bottomRight = screenPos + Vector2.new(width/2, height/2)
                -- Box
                obj.box.Visible = Settings.EspEnabled
                obj.box.Size = Vector2.new(width, height)
                obj.box.Position = topLeft

                -- Name
                if Settings.ShowName then
                    obj.nameTag.Visible = true
                    obj.nameTag.Text = player.Name
                    obj.nameTag.Position = Vector2.new(screenPos.X, topLeft.Y - 20)
                else
                    obj.nameTag.Visible = false
                end

                -- Distance
                if Settings.ShowDistance then
                    local dist = math.floor((Camera.CFrame.Position - pos).Magnitude)
                    obj.distTag.Visible = true
                    obj.distTag.Text = dist .. "m"
                    obj.distTag.Position = Vector2.new(screenPos.X, bottomRight.Y + 5)
                else
                    obj.distTag.Visible = false
                end

                -- Health Bar
                if char:FindFirstChild("Humanoid") then
                    local health = char.Humanoid.Health / char.Humanoid.MaxHealth
                    obj.healthBar.Visible = true
                    obj.healthBar.From = Vector2.new(topLeft.X, bottomRight.Y + 2)
                    obj.healthBar.To = Vector2.new(topLeft.X + width * health, bottomRight.Y + 2)
                    obj.healthBar.Color = Color3.fromHSV(health * 0.3, 1, 1)
                end
            else
                obj.box.Visible = false
                obj.nameTag.Visible = false
                obj.distTag.Visible = false
                obj.healthBar.Visible = false
            end
        else
            obj.box.Visible = false
            obj.nameTag.Visible = false
            obj.distTag.Visible = false
            obj.healthBar.Visible = false
        end
    end
end

-- ========== SÄ°LENT AÄ°M / AÄ°MBOT ==========
local function GetTarget()
    if not Settings.SilentAimEnabled and not Settings.AimbotEnabled then return nil end
    local fov = Settings.AimFOV
    local target = GetClosestPlayer(fov)
    if target then
        local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if root then
            return root
        end
    end
    return nil
end

-- Silent Aim: Mermi yÃ¶nÃ¼nÃ¼ deÄŸiÅŸtir (Fark edilmez)
local function SilentAim()
    if not Settings.SilentAimEnabled then return end
    local target = GetTarget()
    if target then
        -- Burada mermi yÃ¶nÃ¼nÃ¼ hedefe Ã§evir (genelde Mouse'u manipÃ¼le ederek yapÄ±lÄ±r)
        -- Ancak Street Life'da mermi mekaniÄŸi farklÄ± olabilir, genel bir yaklaÅŸÄ±m:
        local mouse = LocalPlayer:GetMouse()
        local screenPos, onScreen = WorldToScreen(target.Position)
        if onScreen then
            -- Mouse'u hedefin Ã¼zerine getir (Silent Aim)
            mouse.Move(screenPos.X, screenPos.Y)
        end
    end
end

-- Aimbot: Otomatik niÅŸan al (AÃ§Ä±k)
local function Aimbot()
    if not Settings.AimbotEnabled then return end
    local target = GetTarget()
    if target then
        local screenPos, onScreen = WorldToScreen(target.Position)
        if onScreen then
            local mouse = LocalPlayer:GetMouse()
            mouse.Move(screenPos.X, screenPos.Y)
        end
    end
end

-- ========== AUTO FARM ==========
local farmTimer = 0
local function AutoFarm(delta)
    if not Settings.AutoFarmEnabled then return end
    farmTimer = farmTimer + delta
    if farmTimer < Settings.AutoFarmDelay then return end
    farmTimer = 0

    local target = GetClosestPlayer(999) -- Herkese saldÄ±r
    if target and target.Character then
        local root = target.Character:FindFirstChild("HumanoidRootPart")
        if root then
            -- SaldÄ±rÄ± simÃ¼lasyonu (genelde mermi veya tÄ±klama)
            local mouse = LocalPlayer:GetMouse()
            local screenPos, onScreen = WorldToScreen(root.Position)
            if onScreen then
                mouse.Move(screenPos.X, screenPos.Y)
                mouse1click() -- KullanÄ±cÄ± arayÃ¼zÃ¼ tÄ±klamasÄ± (bazÄ± oyunlarda)
                -- Daha stabil: 
                -- fire() veya attack() fonksiyonunu Ã§aÄŸÄ±r
                -- Burada genel bir yÃ¶ntem:
                game:GetService("VirtualInputManager"):SendMouseButtonEvent(1, true, false, 0)
                wait(0.05)
                game:GetService("VirtualInputManager"):SendMouseButtonEvent(1, false, false, 0)
            end
        end
    end
end

-- ========== SPEED ==========
local function SetSpeed()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        if Settings.SpeedEnabled then
            char.Humanoid.WalkSpeed = Settings.SpeedValue
        else
            char.Humanoid.WalkSpeed = 16 -- Normal hÄ±z
        end
    end
end

