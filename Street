-- ÖZELLİKLER
local function createFeature(name, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.Position = UDim2.new(0, 10, 0, pos)
    btn.Size = UDim2.new(0, 200, 0, 40)
    btn.Text = name .. ": KAPALI"
    btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    local enabled = false
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        btn.Text = name .. (enabled and ": AÇIK" or ": KAPALI")
        btn.BackgroundColor3 = enabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(200, 0, 0)
        callback(enabled)
    end)
end

-- 1. AUTO OIL FARM (ATMAYA KARŞI GÜVENLİ)
local farmActive = false
createFeature("Auto Oil Farm", 60, function(val)
    farmActive = val
    spawn(function()
        while farmActive do
            task.wait(2) -- Atılmamak için 2 saniye bekleme (Çok önemli!)
            for _, v in pairs(game.Workspace:GetDescendants()) do
                if farmActive and (v.Name == "Oil" or v.Name == "OilBarrel") then
                    local hrp = game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        -- Işınlanma ve Toplama
                        hrp.CFrame = v.CFrame * CFrame.new(0, 2, 0)
                        task.wait(0.5)
                        if v:FindFirstChildOfClass("ProximityPrompt") then
                            fireproximityprompt(v:FindFirstChildOfClass("ProximityPrompt"))
                        end
                        -- Hemen havaya saklan (Görünmemek için)
                        hrp.CFrame = hrp.CFrame * CFrame.new(0, 150, 0)
                        task.wait(2)
                    end
                end
            end
        end
    end)
end)

-- 2. HITBOX EXPANDER (10M ÖLDÜRME)
local hitboxActive = false
createFeature("Hitbox 10m", 120, function(val)
    hitboxActive = val
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if hitboxActive then
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= game.Players.LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local part = p.Character.HumanoidRootPart
                part.Size = Vector3.new(15, 15, 15) -- 10-15 metre arası genişlik
                part.Transparency = 0.6
                part.CanCollide = false
            end
        end
    end
end)

-- 3. AUTO SELL (SATMA)
createFeature("Otomatik Sat", 180, function(val)
    _G.AutoSell = val
    spawn(function()
        while _G.AutoSell do
            task.wait(5)
            local sellPart = game.Workspace:FindFirstChild("SellPoint") or game.Workspace:FindFirstChild("OilSell")
            if sellPart and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = sellPart.CFrame
                task.wait(1)
            end
        end
    end)
end)
