-- Layroxc Özel Script - v3
-- Özellikler: Farm Kapat, Tek Vuruş, Dev Hitbox, Saklanma, Sky-Teleport

local Ayarlar = {
    HitboxBoyutu = Vector3.new(20, 20, 20),
    IsinlanmaYuksekligi = 45, -- Yukarı ışınlanma mesafesi
    SaklanmaSeffafligi = 0.7, -- Karakterin gizliliği
    TekVurus = true
}

-- 1. FARM'I KAPAT
_G.FarmAktif = false
_G.AutoFarm = false -- Farklı scriptler için alternatif isimler

local Player = game:GetService("Players").LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()

-- 2. YUKARI IŞINLAN VE SAKLAN (Hide)
local function SaklanVeYukariIsinla()
    if Character:FindFirstChild("HumanoidRootPart") then
        -- Yukarı ışınlanma işlemi
        Character.HumanoidRootPart.CFrame = Character.HumanoidRootPart.CFrame * CFrame.new(0, Ayarlar.IsinlanmaYuksekligi, 0)
        
        -- Karakteri şeffaf yaparak sakla
        for _, obj in pairs(Character:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Decal") then
                obj.Transparency = Ayarlar.SaklanmaSeffafligi
            end
        end
        
        -- Havada asılı kalmak (Düşmemek) için geçici bir platform oluşturur
        local Floor = Instance.new("Part", Character)
        Floor.Size = Vector3.new(10, 1, 10)
        Floor.CFrame = Character.HumanoidRootPart.CFrame * CFrame.new(0, -3.5, 0)
        Floor.Anchored = true
        Floor.Transparency = 1 -- Görünmez platform
    end
end

-- 3. HITBOX VE TEK VURUŞ DÖNGÜSÜ
task.spawn(function()
    while task.wait(1) do
        for _, target in pairs(game:GetService("Players"):GetPlayers()) do
            if target ~= Player and target.Character then
                local hrp = target.Character:FindFirstChild("HumanoidRootPart")
                local hum = target.Character:FindFirstChild("Humanoid")
                
                -- Hitbox Genişletme
                if hrp then
                    hrp.Size = Ayarlar.HitboxBoyutu
                    hrp.Transparency = 0.6
                    hrp.BrickColor = BrickColor.new("Bright blue")
                    hrp.CanCollide = false
                end
                
                -- Tek Vuruş/Mermi Mantığı (Hasar aldığı an öldürür)
                if Ayarlar.TekVurus and hum then
                    if hum.Health < hum.MaxHealth and hum.Health > 0 then
                        hum.Health = 0
                    end
                end
            end
        end
    end
end)

-- 4. OYUNDAN ATILMAYI ÖNLEME (Anti-Kick Bypass)
local mt = getrawmetatable(game)
setreadonly(mt, false)
local old = mt.__namecall
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "Kick" or method == "kick" then
        return nil
    end
    return old(self, unpack({...}))
end)
setreadonly(mt, true)

-- Başlat
SaklanVeYukariIsinla()
print("Kod tamamlandı. Layroxc için tüm özellikler aktif!")
