-- =============================================================
--  FARM YÖNETİCİSİ (Başlat/Durdur/Yeniden Başlat)
-- =============================================================
local farmState = {
    isRunning = false,
    currentJob = nil,      -- Hangi iş çalışıyor ("all" veya tek)
    loopConnection = nil,
    restartCheck = nil,
}

-- Durum güncelleme (GUI)
local function updateStatus(text, color)
    statusLabel.Text = "Durum: " .. text
    statusLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
end

-- Tüm farmları durdur
function stopFarming()
    if farmState.loopConnection then
        farmState.loopConnection:Disconnect()
        farmState.loopConnection = nil
    end
    if farmState.restartCheck then
        farmState.restartCheck:Disconnect()
        farmState.restartCheck = nil
    end
    farmState.isRunning = false
    farmState.currentJob = nil
    updateStatus("DURDURULDU", Color3.fromRGB(255, 80, 80))
    print("[Farm] Tüm işlemler durduruldu.")
end

-- Farm başlat (jobType: string veya "all")
function startFarming(jobType)
    if farmState.isRunning then
        print("[Farm] Zaten çalışıyor, önce durdur.")
        return
    end

    -- Geçersiz iş kontrolü
    if jobType ~= "all" and not farmActions[jobType] then
        print("[Farm] Geçersiz iş tipi: " .. tostring(jobType))
        return
    end

    farmState.currentJob = jobType
    farmState.isRunning = true
    updateStatus(jobType:upper() .. " ÇALIŞIYOR", Color3.fromRGB(80, 255, 80))
    print("[Farm] '" .. tostring(jobType) .. "' başlatıldı.")

    -- Ana döngü
    farmState.loopConnection = RunService.Heartbeat:Connect(function()
        if not farmState.isRunning then return end

        local jobList = {}
        if farmState.currentJob == "all" then
            for name, func in pairs(farmActions) do
                table.insert(jobList, {name = name, func = func})
            end
        else
            table.insert(jobList, {name = farmState.currentJob, func = farmActions[farmState.currentJob]})
        end

        for _, job in ipairs(jobList) do
            if not farmState.isRunning then break end
            local success, earned = pcall(job.func)
            if success and earned then
                print("[Farm] " .. job.name .. " -> $" .. earned .. " kazanıldı.")
                -- Gerçek para ekleme event'inizi buraya ekleyin:
                -- ReplicatedStorage.Remotes.AddMoney:FireServer(earned)
            else
                print("[Farm] HATA: " .. job.name .. " çalışırken sorun oluştu.")
                -- Hata durumunda işlemi atla ve devam et
            end
            task.wait(CONFIG.FarmInterval)
        end
    end)

    -- Otomatik yeniden başlatma (karakter ölümü, sunucu değişimi vs.)
    if CONFIG.AutoRestart then
        farmState.restartCheck = RunService.Heartbeat:Connect(function()
            if not farmState.isRunning then return end
            local char = player.Character
            if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                print("[Farm] Karakter öldü veya kayboldu, yeniden başlatılıyor...")
                stopFarming()
                -- Biraz bekle ve tekrar başlat
                task.wait(2)
                if farmState.currentJob then
                    startFarming(farmState.currentJob)
                end
            end
        end)
    end
end

-- =============================================================
--  MENÜ AKSİYONLARI
-- =============================================================
function handleAction(action)
    if action == "stop" then
        stopFarming()
        return
    end
    -- Eğer aynı iş zaten çalışıyorsa, durdurup yeniden başlat
    if farmState.isRunning and farmState.currentJob == action then
        stopFarming()
        task.wait(0.5)
    end
    startFarming(action)
end

