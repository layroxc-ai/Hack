-- ============================================================
local FarmManager = {}
FarmManager.running = false
FarmManager.tasks = {}

function FarmManager:start()
    if self.running then return end
    self.running = true
    print("Farm Manager başlatıldı.")
    -- Ana döngüyü başlat
    self:loop()
end

function FarmManager:stop()
    self.running = false
    for _, task in pairs(self.tasks) do
        task:Disconnect()
    end
    self.tasks = {}
    print("Farm Manager durduruldu.")
end

function FarmManager:loop()
    if not self.running then return end
    -- Her 2 saniyede bir farmları kontrol et ve çalıştır
    local conn = runService.Heartbeat:Connect(function()
        if not self.running then conn:Disconnect() return end
        self:checkFarms()
    end)
    table.insert(self.tasks, conn)
end

function FarmManager:checkFarms()
    -- Petrol Farm
    if settings.oilFarm then
        self:doOilFarm()
    end
    -- Mob Farm
    if settings.mobFarm then
        self:doMobFarm()
    end
    -- Doğurma Farm (örnek olarak hayvan veya NPC üretme)
    if settings.breedFarm then
        self:doBreedFarm()
    end
    -- Otomatik satın alma
    if settings.autoBuy then
        self:doAutoBuy()
    end
end

-- === PETROL FARM ===
function FarmManager:doOilFarm()
    -- Örnek: Petrol kulelerini bul ve topla (oyuna göre değiştir)
    local oilRigs = workspace:FindFirstChild("OilRigs") or workspace:FindFirstChild("OilTowers")
    if oilRigs then
        for _, rig in pairs(oilRigs:GetChildren()) do
            if rig:IsA("Model") and rig:FindFirstChild("Collect") then
                -- Toplama butonuna tıkla
                fireclickdetector(rig.Collect)
                wait(0.1)
            end
        end
    end
end

-- === MOB FARM ===
function FarmManager:doMobFarm()
    -- Örnek: Canavarları bul ve saldır
    local mobs = workspace:FindFirstChild("Mobs") or workspace:FindFirstChild("Enemies")
    if mobs then
        for _, mob in pairs(mobs:GetChildren()) do
            if mob:IsA("Model") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                -- Saldırı fonksiyonu (örnek: silah ateşleme)
                -- Burada oyunun saldırı mekaniğine göre ayarla
                -- Örneğin: player.Character:FindFirstChild("Tool") kullan
                local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                    wait(0.2)
                    tool:Deactivate()
                end
            end
        end
    end
end

-- === DOĞURMA FARM ===
function FarmManager:doBreedFarm()
    -- Örnek: Belirli bir bölgede sürekli NPC çağırma veya hayvan doğurma
    -- Bu kısmı oyuna özel düzenlemen gerekir
    local breedZone = workspace:FindFirstChild("BreedZone")
    if breedZone then
        -- Örnek: Her 5 saniyede bir doğurma butonuna tıkla
        local breedBtn = breedZone:FindFirstChild("BreedButton")
        if breedBtn then
            fireclickdetector(breedBtn)
        end
    end
end

-- === OTOMATİK SATIN ALMA (tüm dükkanlar, evler, arabalar) ===
function FarmManager:doAutoBuy()
    local buyables = workspace:FindFirstChild("Buyables") or workspace:FindFirstChild("Shops")
    if buyables then
        for _, obj in pairs(buyables:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChild("BuyButton") then
                fireclickdetector(obj.BuyButton)
                wait(0.3)
            end
        end
    end
end

