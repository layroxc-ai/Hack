-- =================== YARDIMCI FONKSİYONLAR ===================
local function getClosestPlayer(ignoreTeam)
    local closest = nil
    local closestDist = Config.Aimbot.FOV
    local character = LocalPlayer.Character
    if not character then return nil end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if ignoreTeam and player.Team == LocalPlayer.Team then continue end
        local char = player.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local aimPart = char:FindFirstChild(Config.Aimbot.AimPart) or hrp
        local aimPos = aimPart.Position
        local cameraPos = Camera.CFrame.Position
        local direction = (aimPos - cameraPos).Unit
        local lookVector = Camera.CFrame.LookVector
        local angle = math.deg(math.acos(lookVector:Dot(direction)))
        if angle > Config.Aimbot.FOV then continue end

        local dist = (rootPart.Position - aimPos).Magnitude
        if not closest or dist < closestDist then
            closest = player
            closestDist = dist
        end
    end
    return closest
end

local aimbotTarget = nil
local function updateAimbot()
    if not Config.Aimbot.Enabled then return end
    local target = getClosestPlayer(Config.Aimbot.TargetTeam == "Enemy")
    if not target then aimbotTarget = nil return end
    aimbotTarget = target
    local char = target.Character
    if not char then return end
    local aimPart = char:FindFirstChild(Config.Aimbot.AimPart) or char:FindFirstChild("HumanoidRootPart")
    if not aimPart then return end

    if Config.Aimbot.Silent then
        local targetPos = aimPart.Position
        local cameraPos = Camera.CFrame.Position
        local newCF = CFrame.lookAt(cameraPos, targetPos)
        local currentCF = Camera.CFrame
        local lerped = currentCF:Lerp(newCF, Config.Aimbot.Smoothness)
        Camera.CFrame = lerped
    end
end

-- ESP
local espObjects = {}
local function createESP(player)
    if not Config.ESP.Enabled then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local box = Drawing.new("Square")
    box.Thickness = 2
    box.Color = Config.ESP.BoxColor
    box.Transparency = 0.6
    box.Visible = Config.ESP.Enabled

    local nameTag = Drawing.new("Text")
    nameTag.Size = 14
    nameTag.Color = Config.ESP.NameColor
    nameTag.Visible = Config.ESP.Enabled
    nameTag.Center = true

    local healthTag = Drawing.new("Text")
    healthTag.Size = 12
    healthTag.Color = Config.ESP.HealthColor
    healthTag.Visible = Config.ESP.Enabled
    healthTag.Center = true

    local distTag = Drawing.new("Text")
    distTag.Size = 12
    distTag.Color = Config.ESP.DistanceColor
    distTag.Visible = Config.ESP.Enabled
    distTag.Center = true

    espObjects[player] = {box, nameTag, healthTag, distTag}
end

local function updateESP()
    if not Config.ESP.Enabled then
        for player, objects in pairs(espObjects) do
            for _, obj in ipairs(objects) do obj.Visible = false end
        end
        return
    end
    for player, objects in pairs(espObjects) do
        local char = player.Character
        if not char then
            for _, obj in ipairs(objects) do obj.Visible = false end
            continue
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid or humanoid.Health <= 0 then
            for _, obj in ipairs(objects) do obj.Visible = false end
            continue
        end

        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            for _, obj in ipairs(objects) do obj.Visible = false end
            continue
        end

        local size = 60 / (pos.Z * 0.5 + 1)
        local box = objects[1]
        box.Position = Vector2.new(pos.X - size/2, pos.Y - size)
        box.Size = Vector2.new(size, size * 1.5)
        box.Visible = true

        local nameTag = objects[2]
        nameTag.Text = player.Name
        nameTag.Position = Vector2.new(pos.X, pos.Y - size - 20)
        nameTag.Visible = true

        local healthTag = objects[3]
        healthTag.Text = "HP: " .. math.round(humanoid.Health)
        healthTag.Position = Vector2.new(pos.X, pos.Y - size + 5)
        healthTag.Visible = true

        local distTag = objects[4]
        local dist = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") 
            and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude) or 0
        distTag.Text = math.round(dist) .. "m"
        distTag.Position = Vector2.new(pos.X, pos.Y + size + 10)
        distTag.Visible = true
    end
end

-- Wallhack
local function applyWallhack()
    if not Config.Wallhack.Enabled then
        -- eski şeffaflığı geri al (isteğe bağlı) ama basit tutalım
        return
    end
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") and part.Material ~= Enum.Material.Neon then
            pcall(function()
                if part.Transparency < Config.Wallhack.Transparency then
                    part.Transparency = Config.Wallhack.Transparency
                end
            end)
        end
    end
end

-- AutoShoot
local shootTimer = 0
local function autoShoot()
    if not Config.AutoShoot.Enabled or not aimbotTarget then return end
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    pcall(function()
        local fireRemote = tool:FindFirstChild("FireRemote") or tool:FindFirstChild("Activate")
        if fireRemote and fireRemote:IsA("RemoteEvent") then
            fireRemote:FireServer()
        elseif UserInputService then
            UserInputService:SetMouseButtonDown(Enum.UserInputType.MouseButton1)
            task.wait(0.02)
            UserInputService:SetMouseButtonUp(Enum.UserInputType.MouseButton1)
        end
    end)
end

-- Money Farm
local function moneyFarm()
    if not Config.MoneyFarm.Enabled then return end
    pcall(function()
        local moneyButton = PlayerGui:FindFirstChild("MoneyFarmButton")
        if moneyButton and moneyButton:IsA("TextButton") then
            moneyButton:Activate()
        else
            local remote = ReplicatedStorage:FindFirstChild("GetMoney")
            if remote and remote:IsA("RemoteEvent") then
                remote:FireServer()
            end
        end
    end)
end

-- Oil Farm
local function oilFarm()
    if not Config.OilFarm.Enabled then return end
    pcall(function()
        local oilPump = nil
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == Config.OilFarm.OilSourceName and obj:IsA("BasePart") then
                oilPump = obj
                break
            end
        end
        if oilPump then
            local collectRemote = ReplicatedStorage:FindFirstChild("CollectOil")
            if collectRemote and collectRemote:IsA("RemoteEvent") then
                collectRemote:FireServer(oilPump)
            end
        end
        local sellButton = PlayerGui:FindFirstChild(Config.OilFarm.SellButton)
        if sellButton and sellButton:IsA("TextButton") then
            sellButton:Activate()
        else
            local sellRemote = ReplicatedStorage:FindFirstChild("SellOil")
            if sellRemote and sellRemote:IsA("RemoteEvent") then
                sellRemote:FireServer()
            end
        end
    end)
end

-- Zamanlayıcılar
local oilTimer = 0
local moneyTimer = 0

RunService.RenderStepped:Connect(function(delta)
    pcall(function()
        updateAimbot()
        updateESP()
        applyWallhack() -- sürekli uygula

        if Config.AutoShoot.Enabled then
            shootTimer = shootTimer + delta
            if shootTimer >= Config.AutoShoot.Delay then
                shootTimer = 0
                autoShoot()
            end
        end

        if Config.MoneyFarm.Enabled then
            moneyTimer = moneyTimer + delta
            if moneyTimer >= Config.MoneyFarm.Interval then
                moneyTimer = 0
                moneyFarm()
            end
        end

        if Config.OilFarm.Enabled then
            oilTimer = oilTimer + delta
            if oilTimer >= Config.OilFarm.CollectInterval then
                oilFarm()
            end
            if oilTimer >= Config.OilFarm.SellInterval then
                oilFarm()
                oilTimer = 0
            end
        end
    end)
end)

