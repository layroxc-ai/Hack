-- GELİŞMİŞ İSİM, MESAFE VE TRACES (ÇİZGİ) ESP SİSTEMİ
------------------------------------------------------------------------
local ESPTable = {}

local function CreateESP(player)
    local TextObj = Drawing.new("Text")
    TextObj.Color = Color3.fromRGB(255, 0, 0)
    TextObj.Size = 14
    TextObj.Center = true
    TextObj.Outline = true
    TextObj.OutlineColor = Color3.fromRGB(0, 0, 0)
    TextObj.Visible = false

    local LineObj = Drawing.new("Line")
    LineObj.Color = Color3.fromRGB(255, 0, 0)
    LineObj.Thickness = 1
    LineObj.Transparency = 0.7
    LineObj.Visible = false

    ESPTable[player] = {Text = TextObj, Line = LineObj}
end

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then CreateESP(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then CreateESP(p) end
end)

Players.PlayerRemoving:Connect(function(p)
    if ESPTable[p] then
        ESPTable[p].Text:Remove()
        ESPTable[p].Line:Remove()
        ESPTable[p] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    for player, drawings in pairs(ESPTable) do
        if States.ESP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hrp = player.Character.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            
            if onScreen then
                local distance = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude) or 0)
                
                drawings.Text.Position = Vector2.new(pos.X, pos.Y - 40)
                drawings.Text.Text = string.format("%s\n[%dm]", player.Name, distance)
                drawings.Text.Visible = true
                
                drawings.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                drawings.Line.To = Vector2.new(pos.X, pos.Y)
                drawings.Line.Visible = true
            else
                drawings.Text.Visible = false
                drawings.Line.Visible = false
            end
        else
            drawings.Text.Visible = false
            drawings.Line.Visible = false
        end
    end
end)

