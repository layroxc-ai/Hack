-- GÜVENLİ HAREKET FONKSİYONU (ATMAYI ENGELLER)
local function safeMove(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local distance = (hrp.Position - targetCFrame.Position).Magnitude
        local speed = 25 -- Bu hız "kick" yememen için idealdir. Daha hızlısı atar.
        local duration = distance / speed
        
        local ts = game:GetService("TweenService")
        local tween = ts:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        tween:Play()
        return tween
    end
end

-- BUTON OLUŞTURUCU
local function createBtn(text, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 230, 0, 45)
    btn.Position = UDim2.new(0, 10, 0, pos)
    btn.Text = text .. ": KAPALI"
    btn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Parent = Main
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. (state and ": AÇIK" or ": KAPALI")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(150, 0, 0)
        callback(state)
    end)
end

-- 1. SAFE OIL FARM (KAYARAK GİDER)
local farmLoop = false
createBtn("Ultra Oil Farm", 60, function(val)
    farmLoop = val
    spawn(function()
        while farmLoop do
            for _, v in pairs(game.Workspace:GetDescendants()) do
                if farmLoop and (v.Name == "Oil" or v.Name == "OilBarrel") then
                    -- Petrolün 3 metre üstüne yavaşça süzül
                    local t = safeMove(v.CFrame * CFrame.new(0, 3, 0))
                    if t then t.Completed:Wait() end -- Oraya varana kadar bekle
                    
                    task.wait(0.5)
                    -- Topla
                    if v:FindFirstChildOfClass("ProximityPrompt") then
                        fireproximityprompt(v:FindFirstChildOfClass("ProximityPrompt"))
                    end
                    task.wait(1)
                end
            end
            task.wait(2)
        end
    end)
end)

-- 2. HITBOX (MERMİ HİLESİ)
local hbActive = false
createBtn("Hitbox Expander", 120, function(val)
    hbActive = val
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if hbActive then
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= game.Players.LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                hrp.Size = Vector3.new(15, 15, 15) -- 10 metre çapında hitbox
                hrp.Transparency = 0.7
                hrp.CanCollide = false
            end
        end
    end
end)

-- 3. GÖRÜNMEZLİK / SAKLANMA (GÖKYÜZÜ)
createBtn("Gökyüzüne Saklan", 180, function(val)
