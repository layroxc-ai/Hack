-- En Yakın Hedefi Seçme Algoritması
local function GetClosestTarget()
    local target = nil
    local shortestDistance = math.huge
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(v.Character.HumanoidRootPart.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                if dist < Config.AimFOV and dist < shortestDistance then
                    target = v
                    shortestDistance = dist
                end
            end
        end
    end
    return target
end

-- 1. SMOOTH AIMBOT
RunService.RenderStepped:Connect(function()
    if States.Aimbot then
        local target = GetClosestTarget()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            -- Mobilde sarsılma yapmayan temiz kamera odaklanması
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
        end
    end
end)

-- 2. SILENT AIM (Metatable Hooking)
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if States.SilentAim and (method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay") then
        local target = GetClosestTarget()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            return target.Character.Head, target.Character.Head.Position, Vector3.new(0,1,0), target.Character.Head.Material
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

