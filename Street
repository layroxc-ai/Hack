        Silent = true,           -- true = silent aim (hedefe anında yönelme)
        FOV = 120,               -- derece olarak görüş açısı
        Smoothness = 0.2,        -- 0-1 arası, ne kadar yumuşak takip
        TargetTeam = "Enemy",    -- "Enemy" veya "All"
        AimPart = "Head"         -- "Head", "Torso", "HumanoidRootPart"
    },
    ESP = {
        Enabled = true,
