-- Aşağıdaki fonksiyon, oyundaki tüm BodyVelocity'leri yakalayıp gücünü artırır.
-- (Çoğu fling oyunu için çalışır)
local function boostStrength()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BodyVelocity") or v:IsA("BodyThrust") or v:IsA("BodyForce") then
            local currentVel = v.Velocity
            if currentVel and currentVel.Magnitude > 0 then
                -- Mevcut hızı strength ayarı ile çarp
                local direction = currentVel.Unit
                v.Velocity = direction * (currentVel.Magnitude * (settings.strength / 50))
            end
        end
    end
end

