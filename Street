-- Layroxc Street Life - Açma/Kapama Butonlu Mod Menü
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/7Library/UI/main/Library.lua"))()
local Window = Library:CreateWindow("Layroxc v5", "V")

-- Değişkenler
local Ayarlar = {
    HitboxAcik = false,
    ESPAcik = false,
    HitboxBoyutu = 15
}

-- ANTI-KICK BYPASS (Atılmayı Önler)
local mt = getrawmetatable(game)
setreadonly(mt, false)
local old = mt.__namecall
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "Kick" or method == "kick" then return nil end
    return old(self, unpack({...}))
end)
setreadonly(mt, true)

-- MENÜ SEKMESİ
local Tab = Window:CreateTab("Ana Menü")

-- AÇMA KAPAMA TUŞLARI
Tab:CreateToggle("Hitbox (Aç/Kapat)", function(state)
    Ayarlar.HitboxAcik = state
    print("Hitbox Durumu: ", state)
end)

Tab:CreateToggle("ESP (Aç/Kapat)", function(state)
    Ayarlar.ESPAcik = state
    print("ESP Durumu: ", state)
end)

Tab:CreateSlider("Hitbox Boyutu", 5, 50, function(val)
    Ayarlar.HitboxBoyutu = val
end)

-- ANA DÖNGÜ
task.spawn(function()
    while task.wait(0.5) do
        for _, oyuncu in pairs(game:GetService("Players"):GetPlayers()) do
            if oyuncu ~= game.Players.LocalPlayer and oyuncu.Character then
                local hrp = oyuncu.Character:FindFirstChild("HumanoidRootPart")
                
                -- Hitbox Kontrolü
                if hrp then
                    if Ayarlar.HitboxAcik then
                        hrp.Size = Vector3.new(Ayarlar.HitboxBoyutu, Ayarlar.HitboxBoyutu, Ayarlar.HitboxBoyutu)
                        hrp.Transparency = 0.6
                        hrp.BrickColor = BrickColor.new("Bright red")
                        hrp.CanCollide = false
                    else
                        -- Kapatıldığında eski haline döndür
                        hrp.Size = Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                    end
                end

                -- ESP Kontrolü
                if Ayarlar.ESPAcik then
                    if not oyuncu.Character:FindFirstChild("Layroxc_ESP") then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "Layroxc_ESP"
                        highlight.Parent = oyuncu.Character
                        highlight.FillColor = Color3.fromRGB(255, 0, 0)
                        highlight.FillTransparency = 0.5
                    end
                else
                    if oyuncu.Character:FindFirstChild("Layroxc_ESP") then
                        oyuncu.Character.Layroxc_ESP:Destroy()
                    end
                end
            end
        end
    end
end)

print("Layroxc v5 Yüklendi. Menü Tuşu: V")
