-- Çizim Fonksiyonu (Hız Optimize Edilmiş)
DrawButton.MouseButton1Click:Connect(function()
    local url = URLInput.Text
    local speed = tonumber(SpeedInput.Text) or 0.001
    
    if url == "" then 
        warn("Lütfen bir link girin!") 
        return 
    end

    print("Layroxc Draw Başlatıldı...")
    
    -- ÖNEMLİ: Resim işleme kütüphanesi (Genel API kullanımı)
    -- Bu kısım oyunun kendi 'Draw' Event'ini tetiklemelidir.
    -- Aşağıdaki döngü en hızlı çizim mantığına (Task.Wait) göre ayarlanmıştır.

    for x = 1, 64 do
        for y = 1, 64 do
            -- Örnek RemoteEvent (Draw Me oyunu için bunu executor ile bulman gerekir)
            -- game.ReplicatedStorage.DrawEvent:FireServer(Vector2.new(x, y), Color3.fromRGB(255, 0, 0))
            
            task.wait(speed) -- Senin istediğin "Hızlı Çizim" ayarı
        end
    end
    print("Çizim Bitti!")
end)
